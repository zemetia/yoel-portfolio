generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Profile (standalone — no auth needed for portfolio) ────────────────────

model Profile {
  id                String   @id @default(cuid())
  slug              String   @unique @default("main")

  // Personal info
  fullName          String   @default("")
  headline          String   @default("")
  summary           String   @default("")
  location          String   @default("")
  phone             String   @default("")
  email             String   @default("")
  birthDate         DateTime?

  // Social / links
  website           String?
  linkedinUrl       String?
  githubUrl         String?
  twitterUrl        String?
  instagramUrl      String?
  tiktokUrl         String?
  facebookUrl       String?
  youtubeUrl        String?
  mediumUrl         String?

  // Media
  avatarUrl         String?
  resumeUrl         String?

  // Portfolio config
  heroSubtitle      String?
  heroSequences     Json?     // Array of animated text sequences
  visibleSections   String[]  // Which sections to show
  activeTheme       String?   // Theme name
  showPhoto         Boolean   @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills            Skill[]
  education         Education[]
  experience        Experience[]
  projects          Project[]
  publications      Publication[]
  licenses          License[]
  volunteerExp      VolunteerExperience[]
  organizations     Organization[]
  contacts          Contact[]
}

// ─── Skill ───────────────────────────────────────────────────────────────────

model Skill {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name              String
  list              String?  // comma-separated skill names, e.g. "React, Vue, Angular"
  category          String?  // "Frontend", "Backend", "DevOps", "Language", etc.
  proficiency       Int?     // 1-5 scale
  iconSlug          String?  // icon identifier (devicon, simple-icons)
  isVisible         Boolean  @default(true)
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── Education ───────────────────────────────────────────────────────────────

model Education {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution       String
  degree            String?  // "Bachelor", "Master", "PhD", "Diploma"
  field             String?  // "Computer Science", "Mathematics"
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean  @default(false)
  gpa               String?
  description       String?
  logoUrl           String?
  isVisible         Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── Experience ──────────────────────────────────────────────────────────────

model Experience {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company           String
  position          String
  location          String?
  locationType      String?  // "On-site", "Remote", "Hybrid"
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean  @default(false)
  description       String?  @db.Text
  achievements      String[] // bullet-point achievements
  companyUrl        String?
  companyLogo       String?
  employmentType    String?  // "Full-time", "Contract", "Freelance", "Internship"
  images            String[]
  aiHint            String?
  isVisible         Boolean  @default(true)
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── Project ─────────────────────────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title             String
  slug              String   @unique
  summary           String?  @db.Text
  description       String?  @db.Text
  coverImage        String?
  gallery           Json?
  body              Json?    // Rich content blocks for detailed case study

  // Links
  liveUrl           String?
  githubUrl         String?
  projectUrl        String?
  caseStudyUrl      String?

  // Metadata
  year              Int?
  tags              String[]
  images            String[]
  collaborators     String[]
  client            String?
  industry          String?
  duration          String?
  servicesProvided  String[]
  techStack         String[]
  isFeatured        Boolean  @default(false)
  status            PublishStatus @default(PUBLISHED)
  aiHint            String?
  publishedAt       DateTime?
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
  @@index([slug])
  @@index([status])
}

// ─── Publication ─────────────────────────────────────────────────────────────

model Publication {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title             String
  publisher         String?  // Journal, Conference, Blog name
  url               String?
  publishedDate     DateTime?
  description       String?  @db.Text
  authors           String[]
  doi               String?
  publicationType   String?  // "Journal", "Conference", "Book", "Article", "Other"
  isVisible         Boolean  @default(true)
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── License / Certification ─────────────────────────────────────────────────

model License {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name              String
  issuer            String
  url               String?
  issueDate         DateTime?
  expiryDate        DateTime?
  doesNotExpire     Boolean  @default(false)
  credentialId      String?
  credentialUrl     String?
  logoUrl           String?
  images            String[]
  aiHint            String?
  isVisible         Boolean  @default(true)
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── Volunteer Experience ────────────────────────────────────────────────────

model VolunteerExperience {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  organization      String
  role              String
  cause             String?
  location          String?
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean  @default(false)
  description       String?  @db.Text
  achievements      String[]
  isVisible         Boolean  @default(true)
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── Organization (memberships) ──────────────────────────────────────────────

model Organization {
  id                String   @id @default(cuid())
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name              String
  role              String?
  url               String?
  logoUrl           String?
  location          String?
  startDate         DateTime?
  endDate           DateTime?
  isCurrent         Boolean  @default(false)
  description       String?  @db.Text
  isVisible         Boolean  @default(true)
  order             Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([profileId])
}

// ─── Contact (form submissions / inquiry log) ────────────────────────────────

model Contact {
  id                String   @id @default(cuid())
  profileId         String?
  profile           Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  name              String
  email             String
  subject           String?
  message           String   @db.Text
  isRead            Boolean  @default(false)
  repliedAt         DateTime?

  createdAt         DateTime @default(now())

  @@index([profileId])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
}
