# Hermes Agent Stack — Environment Variables
# Copy ke .env.hermes lalu isi nilainya

# ── Hermes ──────────────────────────────────────────────────────────────────
# UID/GID user di dalam container (jalankan: id -u && id -g)
HERMES_UID=1000
HERMES_GID=1000

# API key untuk Gateway — generate: openssl rand -hex 32 (min 8 karakter)
API_SERVER_KEY=

# ── Dashboard Auth ───────────────────────────────────────────────────────────
# URL domain yang di-assign di Dokploy (wajib jika di belakang Traefik)
HERMES_DASHBOARD_PUBLIC_URL=https://hermes.yourdomain.com

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Hash dari password "PviChat2026" — di-generate via: python -c "from plugins.dashboard_auth.basic import hash_password; print(hash_password('PviChat2026'))"
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$16384$8$1$U+JPg8Lyu8DDo7hE29+jhA==$vSH0fv+LV3lTMwZQBSxHPgu5mL5+y7xDL16+vn87qDo=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=545ea58a8cd3a070ee012d3df6e4aa57ae0dd6e059ebe75945bddf9121363f17

# ── Browser ──────────────────────────────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Asia/Jakarta
